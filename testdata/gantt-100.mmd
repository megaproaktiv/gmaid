gantt
    title Legend
    dateFormat YYYY-MM-DD
    axisFormat %Y
    tickInterval 1month

    section Legend
    Done                            :done, legend_done, 2026-06-15, 7d
    Work in Progress                :active, legend_active, 2026-06-15, 7d
    Critical                        :crit, legend_impl, 2026-06-15, 7d
